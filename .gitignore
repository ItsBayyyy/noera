# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# --- di bawah ini khusus proyek ini ---------------------------------------

# Berkas sistem Windows. Dikerjakan di Windows, jadi dua ini muncul sendiri
# di folder mana pun yang pernah dibuka Explorer.
Thumbs.db
ehthumbs.db
desktop.ini

# Pengaturan editor — milik mesin masing-masing, bukan bagian karya.
.vscode/
.idea/
*.swp
*.swo

# Perkakas pengembangan. Sama seperti di .submissionignore: ini yang dipakai
# untuk mengerjakan karya, bukan karyanya sendiri.
.claude/
.mcp.json

# Hasil `npm run package`. Skripnya menulis ke folder induk, jadi biasanya
# tidak kena aturan ini — tetap dicantumkan supaya ZIP dan folder sementara
# tidak pernah ikut ter-commit kalau skripnya dijalankan dari tempat lain.
*_PNBWDC.zip
.pkg-*/

AGENTS.md 
CLAUDE.md 
guidebook.md 

